# ==========================================
# Oblivion-CMS 环境变量配置示例 (Cloudflare Access 纯零信任方案)
# ==========================================

# 1. Cloudflare Access 鉴权配置 (线上生产环境必填)
# 您的 Cloudflare Zero Trust 团队域名（无需包含 https://）
# 例如：your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# 保护 Oblivion-CMS 域名的 Access Application AUD (Audience Tag)
# 可在 Cloudflare Zero Trust -> Access -> Applications 中复制
CF_ACCESS_AUD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. 本地开发模式开关
# 设置为 true 时允许在 localhost/127.0.0.1 运行模拟 Access 鉴权及离线数据模式
DEV_MODE=true
ALLOW_LOCAL_MOCK_AUTH=true

# 3. GitHub 仓库配置
# 目标仓库拥有者与仓库名（例如：AndyCort / oblivion-dashboard）
GITHUB_OWNER=AndyCort
GITHUB_REPO=oblivion-dashboard
GITHUB_BRANCH=main

# 目标文章 TypeScript 数据文件在仓库中的相对路径
# 例如：src/components/data/moments.ts
GITHUB_DATA_PATH=src/components/data/moments.ts

# GitHub 访问令牌 (可在 Cloudflare Pages Secrets 中配置，严禁提交到 Git)
# 推荐使用具备 target repo -> Contents 读写权限的 Fine-grained Personal Access Token
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# 4. 博客长文 Worker（仅服务端使用，不要添加 VITE_ 前缀）
BLOG_WORKER_URL=https://oblivion-content.example.workers.dev
# 在 Pages Secrets 中配置，与博客 Worker 的 PUBLISH_SECRET 相同
BLOG_PUBLISH_SECRET=
# 编辑已有文章需绑定博客同一 D1，以保留 Worker 隐藏的 source_path 文件映射。
# 未设置 BLOG_WORKER_URL 时使用现有 D1 绑定或 REST API 配置；直连不清除 Worker 缓存。
