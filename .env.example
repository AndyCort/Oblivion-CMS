# ==========================================
# Oblivion-CMS 环境变量配置示例
# ==========================================

# 1. Cloudflare Access 鉴权配置 (必填)
# Cloudflare Zero Trust 团队域名（无需 https://）
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# 保护 CMS 域名的 Access Application AUD (Audience Tag)
CF_ACCESS_AUD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. 博客长文 Worker (仅服务端使用，不要添加 VITE_ 前缀)
BLOG_WORKER_URL=https://oblivion-content.example.workers.dev
# 与 oblivion-content Worker 的 PUBLISH_SECRET 一致 (Pages Secret)
BLOG_PUBLISH_SECRET=

# 3. 网易云音乐搜索接口（可选；留空则默认直连网易云官方搜索接口）
# 若 Cloudflare 节点直连受限，可填写自建 NeteaseCloudMusicApi 根地址
# NETEASE_API_URL=https://netease-api.example.com

# 注意：说说动态请在 Pages Settings -> Functions -> D1 database bindings 中绑定 `DB`；
# 编辑既有博客长文还需绑定博客同一 D1 数据库为 `BLOG_DB`（用于保留 source_path）。
